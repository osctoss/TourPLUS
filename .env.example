# TourPlus AI — Environment Configuration Template
# For local and production environments using Supabase (PostgreSQL + PostGIS)

# ==============================================================================
# 1. Supabase Database Configuration
# ==============================================================================
# Supabase provides PostgreSQL with PostGIS support.
# Get these details from: Supabase Dashboard -> Project Settings -> Database
#
# Option A: Connection Pooler (Recommended for serverless / Next.js / high concurrency)
# Transaction mode (port 6543) or Session mode (port 5432):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B: Direct Connection (IPv6 or IPv4 addon):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Local development default:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Discrete PostgreSQL variables (used if DATABASE_URL is not set):
POSTGRES_DB=postgres
POSTGRES_USER=postgres.[YOUR-PROJECT-REF]
POSTGRES_PASSWORD=your-secure-supabase-password
POSTGRES_HOST=aws-0-[YOUR-REGION].pooler.supabase.com
POSTGRES_PORT=6543
POSTGRES_SSLMODE=require

# ==============================================================================
# 2. Supabase API Credentials (Optional / for Auth & Storage integrations)
# ==============================================================================
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ==============================================================================
# 3. Django Backend Configuration
# ==============================================================================
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.tourplus.ai
DJANGO_SETTINGS_MODULE=config.settings.development

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tourplus.ai

# Authentication Tokens
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14

# ==============================================================================
# 4. Next.js Frontend Configuration
# ==============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# 5. External Integrations (Optional / Fallbacks provided)
# ==============================================================================
# LLM Provider (gemini | openai | fallback)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-1.5-flash

# Maps & Route Provider (haversine | google_routes)
MAPS_PROVIDER=haversine
MAPS_API_KEY=your-google-maps-api-key

# Foreign Exchange Rate Provider (curated | open_exchange_rates)
FX_PROVIDER=curated
FX_API_KEY=your-open-exchange-rates-api-key

# Email Settings (Console in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=TourPlus AI <noreply@tourplus.ai>

# ==============================================================================
# 6. Application Feature Flags
# ==============================================================================
DEFAULT_SCENARIO_CURRENCY=USD
ENABLE_DEMO_DATA=True
