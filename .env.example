# TourPlus AI Environment Configuration Template

# Django Configuration
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database Configuration (PostgreSQL + PostGIS)
# Local Docker or Supabase connection string
DATABASE_URL=postgres://tourplus_user:tourplus_password@localhost:5432/tourplus_db
POSTGRES_DB=tourplus_db
POSTGRES_USER=tourplus_user
POSTGRES_PASSWORD=tourplus_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Authentication Tokens
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14

# External Integrations (Optional / Fallbacks provided)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

MAPS_PROVIDER=haversine
MAPS_API_KEY=

FX_PROVIDER=curated
FX_API_KEY=

# Email Settings (Console in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=TourPlus AI <noreply@tourplus.ai>

# Application Feature Flags
DEFAULT_SCENARIO_CURRENCY=USD
ENABLE_DEMO_DATA=True

