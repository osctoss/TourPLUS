# TourPlus AI — Environment Configuration Template

# ==============================================================================
# 1. Supabase Project Credentials (API & Client SDK)
# ==============================================================================
# Found in: Supabase Dashboard -> Project Settings -> API
# Used by Next.js frontend, Supabase client (@supabase/supabase-js), and auth.
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ==============================================================================
# 2. Django Database (PostgreSQL Connection URI)
# ==============================================================================
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Django requires direct PostgreSQL access for migrations, ORM tables, and PostGIS.
# (If left empty, Django automatically falls back to local SQLite db.sqlite3 for development)
#
# Direct connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Or Connection Pooler (port 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# ==============================================================================
# 3. Django Backend Configuration
# ==============================================================================
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.tourplus.ai
DJANGO_SETTINGS_MODULE=config.settings.development

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tourplus.ai

# Authentication Tokens
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14

# ==============================================================================
# 4. Next.js Frontend Configuration
# ==============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# 5. External Integrations (Optional / Fallbacks provided)
# ==============================================================================
# LLM Provider (gemini | openai | fallback)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Maps & Route Provider (haversine | google_routes)
MAPS_PROVIDER=haversine
MAPS_API_KEY=

# Foreign Exchange Rate Provider (curated | open_exchange_rates)
FX_PROVIDER=curated
FX_API_KEY=

# Email Settings (Console in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=TourPlus AI <noreply@tourplus.ai>

# ==============================================================================
# 6. Application Feature Flags
# ==============================================================================
DEFAULT_SCENARIO_CURRENCY=USD
ENABLE_DEMO_DATA=True
